digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Создать заказ сотрудника Order(employee) в статусе DRAFT" ];
n2 [label="Получить товар Product(id, name, price) и количество quantity" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n3 [label="A1: Проверить status == DRAFT, непустые id/name, price > 0, 1 <= quantity <= 100 и лимит объединения <= 35 шт. (вариант 6)" ,fillcolor="#D5F5E3",color="#1E8449",style="rounded,filled"];
n4 [label="Позиция корректна" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n5 [label="Товар уже есть в заказе" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n6 [label="Обновить количество item.increase(qty) или добавить новый OrderItem" ];
n7 [label="Есть ещё позиции" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n8 [label="Рассчитать итог order.total() по всем позициям" ];
n9 [label="A2: Проверить в validateForConfirm (status == DRAFT, !items.isEmpty(), total() > 0) и перевести заказ в статус CONFIRMED" ,fillcolor="#D5F5E3",color="#1E8449",style="rounded,filled"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5 [label="да"];
n4 -> n2 [label="нет"];
n5 -> n6 [label="да или нет"];
n6 -> n7;
n7 -> n2 [label="да"];
n7 -> n8 [label="нет"];
n8 -> n9;
n9 -> end;
}
