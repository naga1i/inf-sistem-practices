sv [label="{BusinessTripService|- trips Map[String,BusinessTrip]\l|+ create(String,LocalDate,LocalDate) BusinessTrip\l+ create(String,Employee,LocalDate,LocalDate) BusinessTrip\l+ findByStatus(TripStatus) List[BusinessTrip]\l+ main(String[]) void\l}", fillcolor="#F7FBFF", color="#2F5597"];
