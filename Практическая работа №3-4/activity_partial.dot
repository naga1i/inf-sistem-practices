digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить количество (quantity), цену (unitPrice), скидку (discountPercent) и ставку НДС (VAT_RATE)" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n2 [label="A1: Проверить диапазоны в isValid / validateInput: 1 <= quantity <= 10 000, 0 < unitPrice <= 5 000 000, 0 <= discountPercent <= 30" ,fillcolor="#D5F5E3",color="#1E8449",style="rounded,filled"];
n3 [label="Данные корректны" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n4 [label="Вычислить базовую сумму: base = calculateBase(quantity, unitPrice)" ];
n5 [label="A2: Применить скидку applyDiscount(base, discountPercent), рассчитать НДС calculateVat(discounted, VAT_RATE), итог total и порог бесплатной обработки >= 35 000" ,fillcolor="#D5F5E3",color="#1E8449",style="rounded,filled"];
n6 [label="Вывести результат в рублях с двумя знаками после запятой (%.2f руб.)" ];
n7 [label="Вывести причину ошибки валидации" ];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4 [label="да"];
n3 -> n7 [label="нет"];
n4 -> n5;
n5 -> n6;
n6 -> end;
n7 -> end;
}
